{
  "name": "sfz.dev",
  "version": "2.0.0",
  "description": "sforzando LLC. Official Website - Built with Hugo and Congo theme",
  "private": true,
  "scripts": {
    "prepare": "lefthook install",
    "format": "npm run check:biome && npm run format:html",
    "check:biome": "biome check --write .",
    "format:html": "prettier --write '**/*.html'",
    "lint": "biome lint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sforzando/sfz.dev.git"
  },
  "keywords": [
    "hugo",
    "congo",
    "website",
    "static-site"
  ],
  "author": "sforzando LLC. and Inc.",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sforzando/sfz.dev/issues"
  },
  "homepage": "https://github.com/sforzando/sfz.dev#readme",
  "dependencies": {
    "@microsoft/clarity": "^1.0.2",
    "mapbox-gl": "^3.33.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "dotenv": "^18.0.8",
    "lefthook": "^2.2.2",
    "lighthouse": "^13.5.0",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.10",
    "prettier-plugin-go-template": "^0.0.15",
    "serve": "^14.2.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
